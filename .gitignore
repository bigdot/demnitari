# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Node / frontend build
node_modules/
site/dist/

# scratch + scrape run state (receipt) — ephemeral, generated in-workspace
tmp/
run/

# generated data (scraped in CI + built into the Pages artifact; not versioned)
# EXCEPTIE: localitati.json (nomenclator SIRUTA, tabel de referinta) e versionat —
# data.gov.ro blocheaza IP-ul runnerului GitHub, deci CI nu-l poate descarca
site/data/*
!site/data/localitati.json
